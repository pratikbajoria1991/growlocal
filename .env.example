# Growlocal — environment variables
# Copy to .env.local for development. Everything is optional: the app runs with
# stub responses and dev-safe defaults when keys are absent.

# --- Public ---
NEXT_PUBLIC_APP_URL=http://localhost:3400

# --- AI agent (Google Gemini) ---
# Without this, agent actions return structured stubs instead of real content.
# Use a billing-enabled key (aistudio.google.com/apikey) — the free tier lets
# Google train on submitted content, which we disclose against in /privacy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Google Business Profile OAuth ---
# The business.manage scope requires Google verification (2-6 weeks).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3400/api/oauth/google/callback

# --- Google Places API (New) ---
# Powers the GBP profile audit tab (score a live Google Business Profile from
# its Maps link). Enable "Places API (New)" in Google Cloud Console with
# billing active. Without this, the GBP tab returns an honest "not configured"
# message rather than fabricating listing data.
GOOGLE_PLACES_API_KEY=

# --- Composio (alternative to GOOGLE_PLACES_API_KEY) ---
# Powers the GBP audit, competitor discovery and growth proposals without a
# Google Cloud project. This is a Composio CONSUMER key (starts with ck_), from
# Composio's AI client / MCP connection page — it authenticates the MCP
# endpoint below, not the REST API. The Google Maps toolkit must be connected
# in that Composio account. If GOOGLE_PLACES_API_KEY is also set, Google's
# Places API is used directly instead.
COMPOSIO_API_KEY=
# COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# --- Operator scripts ---
# Lets scripts (bulk preview websites, bulk proposals) call the concierge APIs
# with `Authorization: Bearer <token>`. 32+ random characters; leave empty to
# disable token access entirely.
CONCIERGE_API_TOKEN=

# --- Concierge console (/concierge) ---
# Comma-separated emails allowed into the internal client console. Fails CLOSED:
# if this is empty, nobody can reach /concierge, including in development.
ADMIN_EMAILS=

# --- Secrets: generate 32+ random chars each for production ---
SESSION_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# --- Persistent store (required on serverless) ---
# Add a Vercel KV / Upstash Redis integration and these are injected automatically.
# Without them, the app falls back to the filesystem locally, and degrades
# gracefully (rather than losing data silently) on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- WhatsApp Business Cloud API (Meta) ---
# Webhook URL to register in Meta: <APP_URL>/api/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- TypeSafe Jev (reply intent + lead-fit classification) ---
TYPESAFE_API_KEY=

# --- Growth Crew (multi-agent GBP / SEO / AEO / GEO fixer) ---
# Claude API key for the agents. Without it the crew route returns 501.
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5-5), per-run token ceiling, refusal fallbacks ("off" to disable)
CREW_MODEL=
CREW_BUDGET_TOKENS=600000
CREW_FALLBACKS=

# Optional: PageSpeed Insights key for /tools/page-speed (falls back to GOOGLE_PLACES_API_KEY
# when the PageSpeed Insights API is enabled on the same Google project)
PAGESPEED_API_KEY=
